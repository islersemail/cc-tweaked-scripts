-- ============================================================
-- LOCKDOWN
-- ============================================================

local function performLockdown()

    setStatus(
        "CLOSING ENTRANCE...",
        BRASS.accent
    )


    local okay,
          err =
        doorCommand(
            "CLOSE"
        )


    if not okay then

        setStatus(
            err,
            BRASS.bad
        )

        sleep(1.2)

        return

    end


    -- Door takes roughly 4.5 seconds.
    -- Five seconds guarantees it is closed
    -- before the Tesla grid activates.

    sleep(5)


    setStatus(
        "ARMING TESLA GRID...",
        BRASS.accent
    )


    okay,
    err =
        securityCommand(
            "ON"
        )


    if not okay then

        setStatus(
            err,
            BRASS.bad
        )

        sleep(1.2)

        return

    end


    if not silentLockdown then

        speaker(
            "ALARM_ON"
        )

    end


    if silentLockdown then

        setStatus(
            "LOCKDOWN - SILENT",
            BRASS.bad
        )

    else

        setStatus(
            "LOCKDOWN ACTIVE",
            BRASS.bad
        )

    end


    sleep(1.2)

end


