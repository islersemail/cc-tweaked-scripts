-- ============================================================
-- BUTTON SYSTEM
-- ============================================================

local function addButton(
    x,
    y,
    width,
    text,
    action,
    theme
)

    theme =
        theme
        or activeTheme

    local maxWidth =
        W - x + 1

    width =
        math.min(
            width,
            maxWidth
        )

    if width < 5 then
        return
    end

    local right =
        x + width - 1


    term.setBackgroundColor(
        theme.bg
    )

    term.setTextColor(
        theme.border
    )


    term.setCursorPos(
        x,
        y
    )

    term.write(
        "+"
        ..
        string.rep(
            "-",
            width - 2
        )
        ..
        "+"
    )


    term.setCursorPos(
        x,
        y + 1
    )

    term.write("|")


    term.setCursorPos(
        right,
        y + 1
    )

    term.write("|")


    term.setCursorPos(
        x,
        y + 2
    )

    term.write(
        "+"
        ..
        string.rep(
            "-",
            width - 2
        )
        ..
        "+"
    )


    local display =
        fit(
            text,
            width - 4
        )


    local tx =
        x
        +
        math.floor(
            (
                width
                -
                #display
            ) / 2
        )


    term.setCursorPos(
        tx,
        y + 1
    )

    term.setTextColor(
        theme.text
    )

    term.write(display)


    table.insert(
        buttons,
        {

            x1 = x,

            y1 = y,

            x2 = right,

            y2 = y + 2,

            action = action
        }
    )

end


local function centeredButton(
    y,
    text,
    action,
    theme,
    requestedWidth
)

    local width =
        math.min(
            requestedWidth
            or 22,

            W - 4
        )

    local x =
        math.floor(
            (
                W
                -
                width
            ) / 2
        ) + 1

    addButton(
        x,
        y,
        width,
        text,
        action,
        theme
    )

end


-- ============================================================
