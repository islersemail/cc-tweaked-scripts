-- ============================================================
-- LIGHTING SYSTEM
-- ============================================================

local function lightsCommand(
    command
)

    local response,
          err =
        requestHost(
            LIGHTS_PROTOCOL,
            LIGHTS_HOST,

            {
                type = "lights",
                command = command
            },

            2
        )


    if not response then

        return false,
            err

    end


    if type(response)
    ~= "table" then

        return false,
            "BAD RESPONSE"

    end


    if response.type
    ~= "lights_response" then

        return false,
            "BAD RESPONSE"

    end


    if response.success
    ~= true then

        return false,
            response.name
            or "COMMAND FAILED"

    end


    return true,
        response.name
        or "PULSE SENT"

end


