-- ============================================================
-- LIGHT ACTION
-- ============================================================

local function toggleLights(
    command,
    name
)

    setStatus(
        "SENDING 0.5s PULSE...",
        BRASS.accent
    )


    local okay,
          message =
        lightsCommand(
            command
        )


    if okay then

        setStatus(
            name
            ..
            " TOGGLED",
            BRASS.good
        )

    else

        setStatus(
            message,
            BRASS.bad
        )

    end


    sleep(0.7)

end


