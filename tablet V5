-- ============================================================
-- SPEAKER SYSTEM
-- ============================================================

local function speaker(
    command
)

    rednet.broadcast(
        command,
        AUDIO_PROTOCOL
    )

end


local function playSequence(
    sequence,
    delay
)

    delay =
        delay
        or 0.30


    for i,
        command
    in ipairs(sequence) do

        speaker(command)


        if i
        < #sequence then

            sleep(delay)

        end

    end

end


