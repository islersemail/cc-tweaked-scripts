-- ============================================================
-- NUMBER FORMATTING
-- ============================================================

local function formatNumber(n)

    n =
        tonumber(n)

    if not n then
        return "N/A"
    end


    local absolute =
        math.abs(n)


    if absolute
    >= 1000000000000 then

        return string.format(
            "%.2fT",
            n / 1000000000000
        )


    elseif absolute
    >= 1000000000 then

        return string.format(
            "%.2fG",
            n / 1000000000
        )


    elseif absolute
    >= 1000000 then

        return string.format(
            "%.2fM",
            n / 1000000
        )


    elseif absolute
    >= 1000 then

        return string.format(
            "%.1fk",
            n / 1000
        )

    end


    return string.format(
        "%.0f",
        n
    )

end


local function formatPercent(n)

    n =
        tonumber(n)

    if not n then
        return "N/A"
    end

    return string.format(
        "%.1f%%",
        n
    )

end


-- ============================================================
-- WIRELESS MODEM
-- ============================================================

local function ensureModem()

    local sides = {

        "top",

        "bottom",

        "left",

        "right",

        "front",

        "back"
    }


    for _, side
    in ipairs(sides) do

        if peripheral.getType(side)
        == "modem" then

            if not rednet.isOpen(side) then

                rednet.open(side)

            end

            return true

        end

    end


    return false

end


-- ============================================================
-- REDNET HOST LOOKUP
-- ============================================================

local function findHost(
    protocol,
    hostname
)

    local id =
        rednet.lookup(
            protocol,
            hostname
        )

    if type(id)
    == "number" then

        return id

    end

    return nil

end


-- ============================================================
-- SEND WITHOUT WAITING FOR RESPONSE
-- ============================================================

local function sendToHost(
    protocol,
    hostname,
    message
)

    local id =
        findHost(
            protocol,
            hostname
        )

    if not id then

        return false,
            "MASTER OFFLINE"

    end


    rednet.send(
        id,
        message,
        protocol
    )

    return true,
        id

end


-- ============================================================
-- SEND AND WAIT FOR RESPONSE
-- ============================================================

local function requestHost(
    protocol,
    hostname,
    message,
    timeout
)

    local okay,
          idOrError =
        sendToHost(
            protocol,
            hostname,
            message
        )


    if not okay then

        return nil,
            idOrError

    end


    local id =
        idOrError


    local timer =
        os.startTimer(
            timeout
            or RESPONSE_TIMEOUT
        )


    while true do

        local event,
              a,
              b,
              c =
            os.pullEvent()


        if event
        == "rednet_message" then

            local sender =
                a

            local response =
                b

            local receivedProtocol =
                c


            if sender == id
            and receivedProtocol
            == protocol then

                return response

            end


        elseif event
        == "timer"
        and a == timer then

            return nil,
                "NO RESPONSE"

        end

    end

end


