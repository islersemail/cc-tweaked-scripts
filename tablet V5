-- ============================================================
-- BUTTON HIT DETECTION
-- ============================================================

local function pressButton(
    x,
    y
)

    for _,
        button
    in ipairs(buttons) do


        if x >= button.x1
        and x <= button.x2
        and y >= button.y1
        and y <= button.y2 then


            button.action()


            return true

        end

    end


    return false

end


-- ============================================================
-- STARTUP MODEM CHECK
-- ============================================================

if not ensureModem() then

    clear(BRASS)


    center(
        math.floor(
            H / 2
        ),
        "NO WIRELESS MODEM",
        BRASS.bad
    )


    center(
        math.floor(
            H / 2
        ) + 2,
        "TABLET CANNOT START",
        BRASS.muted
    )


    return

end


-- ============================================================
-- MAIN EVENT LOOP
-- ============================================================

while true do


    -- ========================================================
    -- TERMINAL EXIT
    -- ========================================================

    if page
    == "__TERMINAL__" then


        term.setBackgroundColor(
            colors.black
        )

        term.setTextColor(
            colors.white
        )

        term.clear()

        term.setCursorPos(
            1,
            1
        )


        print(
            "Exited ISLERRTOPIA OS."
        )


        print(
            "Run 'tablet' to reopen."
        )


        return

    end


    -- ========================================================
    -- DRAW CURRENT SCREEN
    -- ========================================================

    drawPage()


    -- ========================================================
    -- WAIT FOR EVENT
    -- ========================================================

    local event,
          a,
          b,
          c =
        os.pullEvent()


    -- ========================================================
    -- TOUCH / CLICK
    -- ========================================================

    if event
    == "mouse_click" then


        local x = b

        local y = c


        -- ====================================================
        -- UTILITIES FOOTER
        -- Must be checked before generic BACK.
        -- ====================================================

        if page
        == "UTILITIES"
        and y == H then


            if x <= 3 then

                utilityPage =
                    math.max(
                        1,
                        utilityPage - 1
                    )


            elseif x
            >= W - 2 then

                utilityPage =
                    math.min(
                        2,
                        utilityPage + 1
                    )


            elseif x
            >= math.floor(
                W / 2
            ) - 3

            and x
            <= math.floor(
                W / 2
            ) + 3 then


                page =
                    "MAIN"

            end


        -- ====================================================
        -- SPEAKER FOOTER
        -- ====================================================

        elseif page
        == "SPEAKERS"
        and y == H then


            if x <= 3 then

                speakerPage =
                    math.max(
                        1,
                        speakerPage - 1
                    )


            elseif x
            >= W - 2 then

                speakerPage =
                    math.min(
                        2,
                        speakerPage + 1
                    )


            elseif x
            >= math.floor(
                W / 2
            ) - 3

            and x
            <= math.floor(
                W / 2
            ) + 3 then


                page =
                    "UTILITIES"

            end


        -- ====================================================
        -- MATRIX FOOTER
        -- ====================================================

        elseif page
        == "MATRIX"
        and y == H then


            if x <= 8 then

                page =
                    "FE"

            else

                -- Any click on REFRESH simply leaves
                -- page unchanged. The next loop redraws
                -- and requests fresh telemetry.

                page =
                    "MATRIX"

            end


        -- ====================================================
        -- STEAM FOOTER
        -- ====================================================

        elseif page
        == "STEAM"
        and y == H then


            if x <= 8 then

                page =
                    "SU"

            else

                page =
                    "STEAM"

            end


        -- ====================================================
        -- NORMAL BUTTONS
        -- ====================================================

        elseif pressButton(
            x,
            y
        ) then


            -- Button action already handled everything.


        -- ====================================================
        -- GENERIC BACK
        -- ====================================================

        elseif y == H
        and x <= 8
        and page ~= "MAIN" then


            goBack()

        end

    end

end
