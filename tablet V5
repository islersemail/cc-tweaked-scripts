-- ============================================================
-- TEXT HELPERS
-- ============================================================

local function fit(text, width)

    text = tostring(text or "")

    if width <= 0 then
        return ""
    end

    if #text <= width then
        return text
    end

    if width <= 3 then
        return text:sub(1, width)
    end

    return text:sub(
        1,
        width - 3
    ) .. "..."

end


local function clearLine(
    y,
    background
)

    term.setBackgroundColor(
        background
        or activeTheme.bg
    )

    term.setCursorPos(
        1,
        y
    )

    term.write(
        string.rep(
            " ",
            W
        )
    )

end


local function center(
    y,
    text,
    color,
    background
)

    text = fit(
        text,
        W
    )

    term.setBackgroundColor(
        background
        or activeTheme.bg
    )

    term.setTextColor(
        color
        or activeTheme.text
    )

    local x =
        math.floor(
            (W - #text) / 2
        ) + 1

    term.setCursorPos(
        math.max(
            1,
            x
        ),
        y
    )

    term.write(text)

end


local function clear(theme)

    activeTheme =
        theme
        or BRASS

    term.setBackgroundColor(
        activeTheme.bg
    )

    term.setTextColor(
        activeTheme.text
    )

    term.clear()

    term.setCursorPos(
        1,
        1
    )

    buttons = {}

end


